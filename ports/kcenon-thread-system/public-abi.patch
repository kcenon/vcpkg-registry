+++ b/cmake/thread_system_install.cmake
@@ -62,6 +62,34 @@ endfunction()
 ##################################################
 # Install libraries
 ##################################################
+# Backport the public ABI export contract without changing feature selection in
+# the v0.3.2 archive. Read the definitions actually used to compile this directory.
+function(export_thread_system_public_abi)
+  get_directory_property(build_definitions COMPILE_DEFINITIONS)
+  set(public_definitions "")
+  foreach(definition IN LISTS build_definitions)
+    if(definition MATCHES "^(USE_STD_[A-Z_]+|HAS_STD_(ATOMIC_WAIT|LATCH)|KCENON_HAS_COMMON_(CONCEPTS|EXECUTOR)|THREAD_HAS_COMMON_CONCEPTS|BUILD_WITH_COMMON_SYSTEM|THREAD_WORK_STEALING_ENABLED)(=.*)?$")
+      list(APPEND public_definitions "${definition}")
+    endif()
+  endforeach()
+  list(REMOVE_DUPLICATES public_definitions)
+  foreach(target IN ITEMS thread_system thread_base utilities interfaces thread_pool typed_thread_pool lockfree)
+    if(TARGET ${target})
+      get_target_property(aliased_target ${target} ALIASED_TARGET)
+      if(NOT aliased_target)
+        get_target_property(target_type ${target} TYPE)
+        if(target_type STREQUAL "INTERFACE_LIBRARY")
+          set(visibility INTERFACE)
+        else()
+          set(visibility PUBLIC)
+        endif()
+        target_compile_definitions(${target} ${visibility} ${public_definitions})
+        target_compile_features(${target} ${visibility} cxx_std_20)
+      endif()
+    endif()
+  endforeach()
+endfunction()
